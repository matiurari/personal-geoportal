generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model users {
  user_id   String  @id(map: "users_pk") @db.VarChar
  email     String? @db.VarChar
  password  String? @db.VarChar
  is_active String? @db.VarChar
  role      String? @db.VarChar
}
